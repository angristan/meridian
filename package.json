{
  "name": "meridian",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted end-to-end encrypted Obsidian synchronization on Cloudflare",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/angristan/meridian.git"
  },
  "bugs": {
    "url": "https://github.com/angristan/meridian/issues"
  },
  "keywords": [
    "obsidian",
    "sync",
    "end-to-end-encryption",
    "cloudflare-workers"
  ],
  "packageManager": "bun@1.3.9",
  "cloudflare": {
    "bindings": {
      "SETUP_TOKEN": {
        "description": "Choose a unique high-entropy token (at least 32 random bytes). You will enter it once at /setup, after which Meridian permanently disables it."
      }
    }
  },
  "workspaces": [
    "worker",
    "obsidian-plugin",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test && bun run build && bun run deploy:dry",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:dry": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler-dist",
    "dev": "wrangler dev --config wrangler.jsonc",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "plugin:build": "bun run --cwd obsidian-plugin build",
    "plugin:install": "bun scripts/install-plugin.ts",
    "plugin:package": "bun run --cwd obsidian-plugin package",
    "release": "semantic-release",
    "release:prepare": "bun scripts/prepare-release.ts",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "types": "wrangler types --config wrangler.jsonc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/exec": "7.1.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "latest",
    "fflate": "0.8.3",
    "semantic-release": "25.0.8",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  }
}
